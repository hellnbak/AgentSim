{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hellnbak/AgentSim/schemas/content-provenance.schema.json",
  "title": "AgentSim Content Provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "authors", "license", "created_at", "review"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "path"],
      "properties": {
        "repository": {"type": "string", "pattern": "^https://(?![^/?#]*@)[^/?#]+(?:/[^?#]*)?$", "maxLength": 512},
        "revision": {"type": "string", "pattern": "^[a-fA-F0-9]{40,64}$"},
        "path": {"type": "string", "pattern": "^(?![~/])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:])[^/]+(?:/[^/]+)*$", "maxLength": 512}
      }
    },
    "authors": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "license": {"type": "string", "pattern": "^[A-Za-z0-9.+-]{2,64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer_id", "reviewed_at", "policy_id"],
      "properties": {
        "status": {"enum": ["approved", "pending", "rejected"]},
        "reviewer_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "policy_id": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    }
  }
}
