{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hellnbak/AgentSim/schemas/agent-event.schema.json",
  "title": "AgentSim agent event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "timestamp", "event_id", "parent_event_id",
    "caused_by_event_ids", "run_id", "trace_id", "session_id",
    "conversation_id", "agent_id", "agent_instance_id", "principal_id",
    "delegation_id", "data_lineage_id", "taint_labels", "policy_id",
    "policy_version", "approval_id", "mutation_id", "sequence", "producer",
    "execution_mode", "scenario_pack_id", "scenario_id", "scenario_name",
    "scenario_variant", "scenario_risk", "expected_detection", "stage",
    "event_type", "message", "input_trust", "tool_name", "tool_action",
    "tool_risk", "policy_decision", "outcome", "attributes", "mappings"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "timestamp": {"type": "string", "format": "date-time"},
    "event_id": {"type": "string", "minLength": 1},
    "parent_event_id": {"type": ["string", "null"]},
    "caused_by_event_ids": {"type": "array", "items": {"type": "string"}},
    "run_id": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "conversation_id": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "minLength": 1},
    "agent_instance_id": {"type": "string", "minLength": 1},
    "principal_id": {"type": "string", "minLength": 1},
    "delegation_id": {"type": ["string", "null"]},
    "data_lineage_id": {"type": ["string", "null"]},
    "taint_labels": {"type": "array", "items": {"type": "string"}},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "approval_id": {"type": ["string", "null"]},
    "mutation_id": {"type": ["string", "null"]},
    "sequence": {"type": "integer", "minimum": 1},
    "producer": {"const": "AgentSim"},
    "execution_mode": {"const": "simulation_only"},
    "scenario_pack_id": {"type": "string", "minLength": 1},
    "scenario_id": {"type": "string", "minLength": 1},
    "scenario_name": {"type": "string", "minLength": 1},
    "scenario_variant": {"enum": ["malicious", "benign"]},
    "scenario_risk": {"enum": ["low", "medium", "high", "critical"]},
    "lab_artifact_ref": {"type": "string", "pattern": "^lab-artifact://[a-z0-9][a-z0-9._-]+$"},
    "expected_detection": {"type": "boolean"},
    "stage": {"type": "string", "minLength": 1},
    "event_type": {"type": "string", "pattern": "^agent\\."},
    "message": {"type": "string", "minLength": 1},
    "input_trust": {"enum": ["trusted", "untrusted", "mixed", "not_applicable"]},
    "tool_name": {"type": ["string", "null"]},
    "tool_action": {"type": ["string", "null"]},
    "tool_risk": {"enum": ["none", "low", "medium", "high", "critical"]},
    "policy_decision": {"type": "string"},
    "outcome": {"type": "string"},
    "attributes": {"type": "object"},
    "mappings": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string"}
      }
    }
  }
}
