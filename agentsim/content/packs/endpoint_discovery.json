  "abilities": [
    {
      "id": "endpoint.discovery.system-information",
      "name": "System information discovery",
      "description": "Generate process telemetry for a bounded burst of host and operating-system discovery.",
      "risk": "low",
      "platforms": ["Windows", "Linux", "macOS"],
      "mappings": {"mitre_attack": ["T1082"]},
      "execution": {"supported_providers": ["simulate", "local", "docker"], "default_provider": "simulate", "requires_elevation": false, "network_access": "denied", "timeout_seconds": 30, "command_ref": "catalog://endpoint/discovery/system-information", "cleanup_ref": null, "state_changes": false},
      "target_constraints": {"allowed_target_types": ["localhost", "container", "lab-agent"], "production_allowed": false},
      "expected_telemetry": [{"source": "process_creation", "required_fields": ["timestamp", "host_id", "process_name", "command_line", "parent_process_name", "parent_process_id"]}],
      "validation": {"detection_objectives": ["rapid_system_discovery", "python_orchestrated_process_burst"], "benign_controls": ["normal_inventory_collection"]},
      "defenses": ["collect_process_ancestry", "alert_on_unusual_discovery_velocity", "tune_known_inventory_automation"]
    },
