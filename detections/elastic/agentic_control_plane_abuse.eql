/* Elastic Security EQL over normalized AgentSim v2 events. */
any where trace_id : "*" and (
  (event_type == "agent.model.fallback" and attributes.safety_profile_changed == true and attributes.policy_binding_valid == false)
  or (event_type == "agent.policy.decision" and policy_decision == "allow" and attributes.policy_scope == "executor" and attributes.intent_equivalent == true and attributes.policy_version_match == false)
  or (event_type == "agent.approval.reused" and attributes.action_fingerprint_match == false)
  or (event_type == "agent.authorization.context_changed" and attributes.tenant_changed == true and attributes.tenant_binding_valid == false)
  or (event_type == "agent.tool.requested" and attributes.egress_capable == true and attributes.composite_risk == "high")
  or (event_type == "agent.registry.entry.changed" and attributes.capability_expansion == true and attributes.signature_valid == false)
)
