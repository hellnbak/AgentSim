{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hellnbak/AgentSim/schemas/lab-artifact-reference.schema.json",
  "title": "AgentSim Reviewed Lab Artifact Reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "artifact_id", "local_path", "sha256", "size_bytes", "media_type", "artifact_type", "platforms", "purpose", "provenance", "controls", "integrity"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "lab-artifact-reference"},
    "artifact_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "local_path": {"type": "string", "pattern": "^(?![~/])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:])[^/]+(?:/[^/]+)*$", "maxLength": 512},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "size_bytes": {"type": "integer", "minimum": 1, "maximum": 33554432},
    "media_type": {"type": "string", "pattern": "^[^/ ]+/[^/ ]+$"},
    "artifact_type": {"enum": ["archive", "data", "document", "executable", "script"]},
    "platforms": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string", "minLength": 1}},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 1000},
    "provenance": {"$ref": "content-provenance.schema.json"},
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lab_only", "production_allowed", "network_access", "execution_allowed", "ephemeral_container_required", "cleanup_required", "max_runtime_seconds", "max_memory_mb"],
      "properties": {
        "lab_only": {"const": true},
        "production_allowed": {"const": false},
        "network_access": {"const": "denied"},
        "execution_allowed": {"const": false},
        "ephemeral_container_required": {"const": true},
        "cleanup_required": {"const": true},
        "max_runtime_seconds": {"type": "integer", "minimum": 1, "maximum": 600},
        "max_memory_mb": {"type": "integer", "minimum": 1, "maximum": 4096}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
