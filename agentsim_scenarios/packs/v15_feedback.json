{
  "pack_schema_version": "1.0",
  "pack_id": "agentsim.v15-feedback",
  "scenarios": [
    {
      "scenario_id": "alert-verdict-poisoning",
      "name": "Alert verdict poisoning",
      "description": "Models an agent-authored false-positive verdict being used to propose broad suppression of a real synthetic alert.",
      "risk": "critical",
      "mappings": {
        "mitre_atlas": ["Impersonation", "AI Agent Context Poisoning"],
        "owasp_agentic": ["ASI03 Identity and Privilege Abuse", "ASI08 Cascading Failures", "ASI10 Rogue Agents"]
      },
      "detector": {"type": "ordered_sequence", "conditions": [
        {"event_type": "agent.feedback.submitted", "equals": {"attributes.evidence_digest_match": false, "attributes.feedback_disposition": "false_positive"}},
        {"event_type": "agent.detection.tuned", "equals": {"attributes.suppression_expanded": true}}
      ]},
      "malicious_steps": [
        {"event_type": "agent.detection.alerted", "stage": "detection", "message": "A critical synthetic alert was emitted with a stable trace identifier.", "agent_id": "detection-agent", "outcome": "detected", "attributes": {"alert_id": "alert-verdict-1", "alert_trace_id": "trace-verdict-malicious", "alert_severity": "critical"}},
        {"event_type": "agent.feedback.submitted", "stage": "feedback", "message": "An agent-authored false-positive verdict failed identity and evidence binding.", "agent_id": "remediation-agent", "input_trust": "untrusted", "outcome": "rejected", "caused_by_sequences": [1], "attributes": {"alert_id": "alert-verdict-1", "feedback_id": "feedback-verdict-1", "feedback_disposition": "false_positive", "feedback_author_type": "agent", "identity_binding_valid": false, "evidence_digest_match": false, "executed": false}},
        {"event_type": "agent.detection.tuned", "stage": "tuning", "message": "The rejected verdict proposed a broad synthetic suppression change.", "agent_id": "remediation-agent", "policy_decision": "deny", "outcome": "blocked", "caused_by_sequences": [2], "attributes": {"tuning_scope": "wildcard", "suppression_expanded": true, "executed": false}},
        {"event_type": "agent.monitoring.coverage", "stage": "validation", "message": "Offline validation showed malicious recall would fall below the baseline.", "agent_id": "validation-agent", "outcome": "regressed", "caused_by_sequences": [3], "attributes": {"detection_recall": 0.5, "false_positive_rate": 0.0, "drift_exceeds_threshold": true}},
        {"event_type": "agent.policy.decision", "stage": "policy", "message": "The tuning proposal remained simulated and was denied.", "agent_id": "validation-agent", "policy_decision": "deny", "outcome": "prevented", "caused_by_sequences": [4], "attributes": {"executed": false}}
      ],
      "benign_steps": [
        {"event_type": "agent.detection.alerted", "stage": "detection", "message": "A critical synthetic alert was emitted with a stable trace identifier.", "agent_id": "detection-agent", "outcome": "detected", "attributes": {"alert_id": "alert-verdict-1", "alert_trace_id": "trace-verdict-benign", "alert_severity": "critical"}},
        {"event_type": "agent.feedback.submitted", "stage": "feedback", "message": "An authenticated human confirmed the alert against its evidence digest.", "agent_id": "review-agent", "input_trust": "trusted", "outcome": "verified", "caused_by_sequences": [1], "attributes": {"alert_id": "alert-verdict-1", "feedback_id": "feedback-verdict-1", "feedback_disposition": "confirmed_true_positive", "feedback_author_type": "human", "identity_binding_valid": true, "evidence_digest_match": true, "executed": false}},
        {"event_type": "agent.detection.tuned", "stage": "tuning", "message": "The confirmed alert produced no suppression expansion.", "agent_id": "remediation-agent", "policy_decision": "allow", "outcome": "unchanged", "caused_by_sequences": [2], "attributes": {"tuning_scope": "none", "suppression_expanded": false, "executed": false}},
        {"event_type": "agent.monitoring.coverage", "stage": "validation", "message": "Offline validation preserved malicious recall and the benign baseline.", "agent_id": "validation-agent", "outcome": "stable", "caused_by_sequences": [3], "attributes": {"detection_recall": 1.0, "false_positive_rate": 0.0, "drift_exceeds_threshold": false}},
        {"event_type": "agent.policy.decision", "stage": "policy", "message": "The unchanged synthetic configuration passed validation.", "agent_id": "validation-agent", "policy_decision": "allow", "outcome": "verified", "caused_by_sequences": [4], "attributes": {"executed": false}}
      ]
    },
    {
      "scenario_id": "alert-trace-reconciliation-confusion",
      "name": "Alert-to-trace reconciliation confusion",
      "description": "Models a real alert being attached to conflicting traces and tenants before a false-positive disposition.",
      "risk": "critical",
      "mappings": {
        "mitre_atlas": ["Impersonation", "AI Agent Context Poisoning"],
        "owasp_agentic": ["ASI03 Identity and Privilege Abuse", "ASI07 Insecure Inter-Agent Communication", "ASI09 Human-Agent Trust Exploitation"]
      },
      "detector": {"type": "ordered_sequence", "conditions": [
        {"event_type": "agent.alert.reconciled", "equals": {"attributes.alert_trace_match": false, "attributes.tenant_binding_valid": false}},
        {"event_type": "agent.feedback.submitted", "equals": {"attributes.feedback_disposition": "false_positive"}}
      ]},
      "malicious_steps": [
        {"event_type": "agent.detection.alerted", "stage": "detection", "message": "A synthetic alert referenced one trace and one tenant.", "agent_id": "detection-agent", "outcome": "detected", "attributes": {"alert_id": "alert-reconcile-1", "alert_trace_id": "trace-tenant-a", "tenant_id": "tenant-a"}},
        {"event_type": "agent.alert.reconciled", "stage": "correlation", "message": "Evidence identifiers resolved to conflicting trace and tenant candidates.", "agent_id": "correlation-agent", "input_trust": "untrusted", "outcome": "ambiguous", "caused_by_sequences": [1], "attributes": {"alert_id": "alert-reconcile-1", "alert_trace_match": false, "tenant_binding_valid": false, "candidate_trace_count": 2}},
        {"event_type": "agent.feedback.submitted", "stage": "feedback", "message": "The ambiguous alert received a false-positive disposition without resolution.", "agent_id": "review-agent", "input_trust": "untrusted", "outcome": "rejected", "caused_by_sequences": [2], "attributes": {"alert_id": "alert-reconcile-1", "feedback_disposition": "false_positive", "evidence_digest_match": false, "executed": false}},
        {"event_type": "agent.alert.quarantined", "stage": "containment", "message": "The conflicted alert was quarantined from tuning automation.", "agent_id": "policy-agent", "policy_decision": "deny", "outcome": "quarantined", "caused_by_sequences": [2, 3], "attributes": {"executed": false}},
        {"event_type": "agent.policy.decision", "stage": "policy", "message": "No alert suppression or external change was allowed.", "agent_id": "policy-agent", "policy_decision": "deny", "outcome": "prevented", "caused_by_sequences": [4], "attributes": {"executed": false}}
      ],
      "benign_steps": [
        {"event_type": "agent.detection.alerted", "stage": "detection", "message": "A synthetic alert referenced one trace and one tenant.", "agent_id": "detection-agent", "outcome": "detected", "attributes": {"alert_id": "alert-reconcile-1", "alert_trace_id": "trace-tenant-a", "tenant_id": "tenant-a"}},
        {"event_type": "agent.alert.reconciled", "stage": "correlation", "message": "The alert and evidence resolved to the same trace and tenant.", "agent_id": "correlation-agent", "input_trust": "trusted", "outcome": "matched", "caused_by_sequences": [1], "attributes": {"alert_id": "alert-reconcile-1", "alert_trace_match": true, "tenant_binding_valid": true, "candidate_trace_count": 1}},
        {"event_type": "agent.feedback.submitted", "stage": "feedback", "message": "An authenticated reviewer confirmed the reconciled alert.", "agent_id": "review-agent", "input_trust": "trusted", "outcome": "verified", "caused_by_sequences": [2], "attributes": {"alert_id": "alert-reconcile-1", "feedback_disposition": "confirmed_true_positive", "evidence_digest_match": true, "executed": false}},
        {"event_type": "agent.alert.quarantined", "stage": "containment", "message": "No quarantine was required for the reconciled alert.", "agent_id": "policy-agent", "policy_decision": "allow", "outcome": "not_required", "caused_by_sequences": [2, 3], "attributes": {"executed": false}},
        {"event_type": "agent.policy.decision", "stage": "policy", "message": "The verified feedback remained available for human review.", "agent_id": "policy-agent", "policy_decision": "allow", "outcome": "verified", "caused_by_sequences": [4], "attributes": {"executed": false}}
      ]
    },
    {
      "scenario_id": "operator-annotation-trust-abuse",
