{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hellnbak/AgentSim/schemas/runtime-conformance-report.schema.json",
  "title": "AgentSim Cross-Runtime Fixture Conformance Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "fixture_id", "source_runtime", "passed", "event_count", "profile_count", "profiles", "safety"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "cross-runtime-fixture-conformance"},
    "fixture_id": {"type": "string", "minLength": 1},
    "source_runtime": {"type": "string", "minLength": 1},
    "passed": {"type": "boolean"},
    "event_count": {"type": "integer", "minimum": 1, "maximum": 2000},
    "profile_count": {"type": "integer", "minimum": 1, "maximum": 3},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile", "profile_version", "passed", "event_count", "invariant_checks", "native_coverage_percent", "failures"],
        "properties": {
          "profile": {"enum": ["otel", "ecs", "ocsf"]},
          "profile_version": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "event_count": {"type": "integer", "minimum": 1},
          "invariant_checks": {"type": "integer", "minimum": 1},
          "native_coverage_percent": {"type": "number", "minimum": 0, "maximum": 100},
          "failures": {"type": "array", "maxItems": 200, "items": {"type": "object"}}
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synthetic_only", "execution_performed", "network_opened", "content_values_recorded"],
      "properties": {
        "synthetic_only": {"const": true},
        "execution_performed": {"const": false},
        "network_opened": {"const": false},
        "content_values_recorded": {"const": false}
      }
    }
  }
}
