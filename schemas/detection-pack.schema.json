{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsim.dev/schemas/detection-pack.schema.json",
  "title": "AgentSim Detection Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["pack_schema_version", "pack_id", "name", "version", "description", "rules", "metadata"],
  "properties": {
    "pack_schema_version": {"const": "1.0"},
    "pack_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "rule_id", "name", "severity", "expression", "required_fields", "expected_sources"],
        "properties": {
          "schema_version": {"const": "1.0"},
          "rule_id": {"type": "string", "minLength": 3},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "severity": {"enum": ["low", "medium", "high", "critical"]},
          "group_by": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "mappings": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "expression": {"type": "object", "required": ["type"]},
          "metadata": {"type": "object"},
          "required_fields": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "expected_sources": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    },
    "metadata": {"type": "object"}
  }
}
